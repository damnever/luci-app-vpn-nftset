#!/bin/sh

usage() {
    cat <<EOF
Usage: $0 [-w GFWList-URL] [-u domain-list-URL] [-s DNS-IP[#port]] -i nftset [-d dnsmasq-directory]
          [-c cache-directory] [-r runtime-directory] [-o] [-n]
  -w, -u  May be repeated. Plain lists contain one domain per line.
  -s, -i  May be repeated. DNS is optional; nftsets are required.
  -c      Persistent source cache (default /etc/vpn-nftset).
  -r      Temporary update state (default /tmp/vpn-nftset).
  -o      Render cached sources without downloading.
  -n      Leave dnsmasq restart to the caller.
EOF
    exit "$1"
}

DNSMASQ_CONFD=/tmp/dnsmasq.d
CACHE_DIR=/etc/vpn-nftset
RUNTIME_DIR=/tmp/vpn-nftset
DATA_TOOL=${VPN_NFTSET_DATA_TOOL:-${VPN_NFTSET_DATA:-/usr/bin/vpn-nftset-data}}
LUA=${VPN_NFTSET_LUA:-lua}
DNSMASQ_INIT=${VPN_NFTSET_DNSMASQ_INIT:-/etc/init.d/dnsmasq}
sources=""
dns_servers=""
nftsets=""
offline=0
no_restart=0
tab=$(printf '\t')
newline='
'

while getopts ':w:u:s:i:d:c:r:onh' option; do
    case "$option" in
        w|u)
            case "$OPTARG" in
                *[[:space:]]*|http://|https://) echo 'Invalid source URL' >&2; exit 1 ;;
                http://*|https://*) ;;
                *) echo 'Source URLs must use HTTP or HTTPS' >&2; exit 1 ;;
            esac
            kind=plain
            [ "$option" = w ] && kind=gfw
            sources="${sources}${kind}${tab}${OPTARG}${newline}"
            ;;
        s) dns_servers="${dns_servers}${OPTARG}${newline}" ;;
        i) nftsets="${nftsets:+$nftsets,}${OPTARG}" ;;
        d) DNSMASQ_CONFD=$OPTARG ;;
        c) CACHE_DIR=$OPTARG ;;
        r) RUNTIME_DIR=$OPTARG ;;
        o) offline=1 ;;
        n) no_restart=1 ;;
        h) usage 0 ;;
        *) usage 1 ;;
    esac
done
shift $((OPTIND - 1))
if [ "$#" -ne 0 ] || [ -z "$nftsets" ]; then usage 1; fi

mkdir -p "$DNSMASQ_CONFD" "$CACHE_DIR" "$RUNTIME_DIR" || exit 1
lockdir="$RUNTIME_DIR/update.lock"
if ! mkdir "$lockdir" 2>/dev/null; then
    owner=$(cat "$lockdir/pid" 2>/dev/null)
    case "$owner" in
        ''|*[!0-9]*) echo 'A domain update is already running' >&2; exit 1 ;;
    esac
    if kill -0 "$owner" 2>/dev/null || ! mkdir "$lockdir/recovery" 2>/dev/null; then
        echo 'A domain update is already running' >&2
        exit 1
    fi
    # Only one contender can claim recovery inside the old lock. Recheck its
    # owner before removing it so another process's fresh lock is never stolen.
    if [ "$(cat "$lockdir/pid" 2>/dev/null)" != "$owner" ] || kill -0 "$owner" 2>/dev/null; then
        rmdir "$lockdir/recovery" 2>/dev/null
        echo 'A domain update is already running' >&2
        exit 1
    fi
    rm -rf "$lockdir"
    mkdir "$lockdir" 2>/dev/null || exit 1
fi
printf '%s\n' "$$" > "$lockdir/pid" || exit 1
workdir=$(mktemp -d "$RUNTIME_DIR/domains.XXXXXX") || { rm -rf "$lockdir"; exit 1; }
trap 'rm -rf "$workdir"; if [ "$(cat "$lockdir/pid" 2>/dev/null)" = "$$" ]; then rm -rf "$lockdir"; fi' EXIT
trap 'exit 1' HUP INT TERM

printf '%s' "$sources" > "$workdir/sources.input"
printf '%s' "$dns_servers" > "$workdir/dns.input"
: > "$workdir/custom.input"
# Validate DNS and nftset inputs before changing any cache.
"$LUA" "$DATA_TOOL" generate-custom "$workdir/custom.input" "$workdir/dns.input" "$nftsets" "$workdir/empty.conf" || exit 1

download() {
    if command -v curl >/dev/null 2>&1; then
        curl -f -s -S -L --connect-timeout 10 --max-time 60 "$1" -o "$2"
    elif command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -T 60 "$1" -O "$2"
    else
        wget -q -T 60 -t 1 "$1" -O "$2"
    fi
}

replace_changed() {
    if [ ! -f "$2" ] || ! cmp -s "$1" "$2"; then
        # A destination sibling keeps replacement atomic across filesystems.
        # Unchanged lists avoid writes to the router's persistent flash.
        cp "$1" "$2.new" && mv "$2.new" "$2"
    fi
}

check_cancelled() {
    if [ -n "${VPN_NFTSET_CANCEL_FILE:-}" ] && [ -f "$VPN_NFTSET_CANCEL_FILE" ]; then
        echo 'Domain update cancelled by a service configuration change' >&2
        exit 1
    fi
}

: > "$workdir/sources.tsv"
: > "$workdir/domains.all"
failed=0
while IFS="$tab" read -r kind url; do
    [ -n "$url" ] || continue
    check_cancelled
    id=$(printf '%s' "$url" | md5sum | awk '{print $1}')
    if awk -F '\t' -v id="$id" '$2 == id { found = 1 } END { exit !found }' "$workdir/sources.tsv"; then
        continue
    fi
    printf '%s\t%s\t%s\n' "$kind" "$id" "$url" >> "$workdir/sources.tsv"
    if [ ! -f "$CACHE_DIR/$id.domains" ]; then
        legacy_id=$(printf '%s\n' "$url" | md5sum | awk '{print $1}')
        legacy_conf="$DNSMASQ_CONFD/vpn-nftset-gen_$legacy_id.conf"
        if [ -f "$legacy_conf" ]; then
            awk -F '/' '/^nftset=\// { print $2 }' "$legacy_conf" > "$workdir/legacy.input"
            if "$LUA" "$DATA_TOOL" parse-domains plain "$workdir/legacy.input" "$workdir/legacy.parsed"; then
                replace_changed "$workdir/legacy.parsed" "$CACHE_DIR/$id.domains" || exit 1
            fi
        fi
    fi
    if [ "$offline" -eq 0 ]; then
        status=ok
        if ! download "$url" "$workdir/download"; then
            status=download_failed
        else
            input="$workdir/download"
            if [ "$kind" = gfw ]; then
                input="$workdir/decoded"
                if ! base64 -d < "$workdir/download" > "$input" 2>/dev/null; then
                    status=invalid_data
                fi
            fi
            if [ "$status" = ok ] && ! "$LUA" "$DATA_TOOL" parse-domains "$kind" "$input" "$workdir/parsed"; then
                status=invalid_data
            fi
        fi
        check_cancelled
        if [ "$status" = ok ]; then
            replace_changed "$workdir/parsed" "$CACHE_DIR/$id.domains" || exit 1
            date +%s > "$workdir/success"
            replace_changed "$workdir/success" "$CACHE_DIR/$id.success" || exit 1
        else
            failed=1
            echo "Domain source update failed ($status): $url; retaining previous cache" >&2
        fi
        printf '%s\n' "$status" > "$workdir/status"
        replace_changed "$workdir/status" "$RUNTIME_DIR/$id.status" || exit 1
    fi
    if [ -f "$CACHE_DIR/$id.domains" ]; then
        if "$LUA" "$DATA_TOOL" parse-domains plain "$CACHE_DIR/$id.domains" "$workdir/cached"; then
            cat "$workdir/cached" >> "$workdir/domains.all"
        else
            failed=1
            echo "Invalid cached domain source: $url" >&2
        fi
    fi
done < "$workdir/sources.input"
check_cancelled
replace_changed "$workdir/sources.tsv" "$CACHE_DIR/sources.tsv" || exit 1
sort -u "$workdir/domains.all" > "$workdir/domains.unique"

# Suppress exact custom duplicates. Retain a downloaded child of a custom parent:
# dnsmasq gives that more specific child its own configured upstream DNS.
: > "$workdir/custom.domains"
if [ -f "$DNSMASQ_CONFD/vpn-nftset-domains.conf" ]; then
    awk -F '/' '/^(server|nftset)=\// { print tolower($2) }' "$DNSMASQ_CONFD/vpn-nftset-domains.conf" | sort -u > "$workdir/custom.domains"
fi
awk 'FILENAME == ARGV[1] { custom[$0] = 1; next } !custom[$0]' "$workdir/custom.domains" "$workdir/domains.unique" > "$workdir/effective.domains"

"$LUA" "$DATA_TOOL" generate-custom "$workdir/effective.domains" "$workdir/dns.input" "$nftsets" "$workdir/generated.conf" || exit 1

changed=0
outfile="$DNSMASQ_CONFD/vpn-nftset-generated.conf"
check_cancelled
if [ ! -f "$outfile" ] || ! cmp -s "$workdir/generated.conf" "$outfile"; then
    replace_changed "$workdir/generated.conf" "$outfile" || exit 1
    changed=1
fi
for file in "$DNSMASQ_CONFD"/vpn-nftset-gen_*.conf; do
    [ -f "$file" ] || continue
    rm "$file" || exit 1
    changed=1
done
if [ "$changed" -eq 1 ] && [ "$no_restart" -eq 0 ]; then
    "$DNSMASQ_INIT" restart || exit 1
fi
exit "$failed"
